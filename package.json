{
  "name": "person360",
  "private": true,
  "version": "0.1.0",
  "description": "Person360: multi-agency public protection for Scotland, high-fidelity desktop mockup",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm contrast && pnpm --filter @mas/web build",
    "contact-sheet": "node tooling/contact-sheet/build.mjs",
    "contrast": "node tooling/contrast/check.mjs",
    "crypto:inventory": "node tooling/crypto-inventory.mjs",
    "crypto:inventory:check": "node tooling/crypto-inventory.mjs --check",
    "desktop:electron:build": "pnpm --filter @mas/web build && pnpm --filter @mas/desktop-electron build",
    "desktop:electron:dev": "pnpm --filter @mas/desktop-electron dev",
    "desktop:tauri:build": "pnpm --filter @mas/web build && pnpm --filter @mas/desktop-tauri build",
    "desktop:tauri:dev": "pnpm --filter @mas/desktop-tauri dev",
    "dev": "pnpm --filter @mas/web dev",
    "docs:data-model": "pnpm --filter @mas/domain docs:data-model",
    "docs:verification-table": "pnpm --filter @mas/domain docs:verification-table",
    "e2e": "pnpm --filter @mas/web e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "holidays:sync": "node tooling/holidays/sync.mjs",
    "lint": "pnpm -r --workspace-concurrency=2 lint && pnpm lint:css && pnpm contrast && pnpm lint:dashes && pnpm lint:placeholders && pnpm demo:check && pnpm messages:check && pnpm lint:crypto && pnpm crypto:inventory:check && pnpm lint:dialog",
    "lint:crypto": "node tooling/no-weak-crypto.mjs",
    "lint:css": "stylelint \"apps/web/**/*.css\" \"packages/ui/**/*.css\" --ignore-path .gitignore && node tooling/stylelint-config/unused-custom-properties.mjs",
    "lint:dashes": "node tooling/no-em-dash.mjs",
    "lint:dialog": "node tooling/dialog-margin-guard.mjs",
    "messages:check": "node tooling/messages/check.mjs",
    "messages:extract": "node tooling/messages/extract.mjs",
    "messages:merge": "node tooling/messages/merge.mjs",
    "messages:types": "node tooling/messages/types.mjs",
    "seed:export": "pnpm --filter @mas/mock-data seed:export",
    "test": "pnpm -r --workspace-concurrency=2 test",
    "typecheck": "pnpm -r --workspace-concurrency=2 typecheck",
    "lint:placeholders": "node tooling/no-placeholder-copy.mjs",
    "demo:check": "node tooling/demo-script/check.mjs"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "sharp": "^0.35.4",
    "stylelint": "17.14.1",
    "stylelint-config-standard": "40.0.0",
    "stylelint-order": "8.1.1",
    "typescript": "5.9.3"
  }
}
